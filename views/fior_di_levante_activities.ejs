<!DOCTYPE html>
<html>
    <head>
        <title>Fior di Levante | Activities</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css">
        <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>
        
        <script src="https://kit.fontawesome.com/38fe6d47dd.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="http://fonts.cdnfonts.com/css/brightwall" rel="stylesheet">
                
        <link rel="stylesheet" href="../fior_di_levante.css">

        <script src="../fior_di_levante.js"></script>

        <script>
            /*ACTIVITIES FILTER*/
            $(document).ready(function(){
                var $activities = $(".activity-item");
                $("#filters > button").click(function(e){
                    e.preventDefault();
                    var filter = this.id;
                    if (filter == "all"){
                        $activities.show();
                    }else {
                        $activities.hide().filter('.'+filter).show();
                    }
                });
            });
        </script>

        <style>
            #filters > button{
                margin: 15px;
            }

            .activity-category{
                display:inline-block;
            }

            .activity-category::first-letter {
                text-transform: uppercase;
            }

            .activity-item img {
                width: 100%;
                display: block;
            }

            .activity-item .item-box {
                display: flex;
                padding: 50px;
                overflow: hidden;
                align-items: center;
                max-width: 1000px;
                margin: auto;
                color: #333;
                font-family: 'Lato', sans-serif;
                font-size: 16px;
                border-radius: 6px;
                margin-bottom: 50px;
                text-decoration: none;
                -webkit-transition: all .3s ease;
                transition: all .3s ease;
            }

            .activity-item .item-box:hover {
                box-shadow: 0 10px 50px 0 rgba(0, 0, 0, 0.2);
                -webkit-transition: all .3s ease;
                transition: all .3s ease;
            }

            .activity-item .icon {
                width: 35%;
                object-fit: cover;
                margin-right: 50px;
                border-radius: 6px;
                overflow: hidden;
                box-shadow: 0 15px 26px rgba(0, 0, 0, 0.4);
            }

            .activity-item .content {
                width: 65%;
            }

            .activity-item .content .title{
                font-size: 21px;
                text-transform: capitalize;
                color: #25aae1;
                font-weight: 600;
                font-family: 'Lato', sans-serif;
            }



            .activity-item .content .title :before{
                font-size: 12px;
                margin-left: 20px;
                color: #333;
                font-family: 'Lato', sans-serif;
            }

            .activity-item .content .title {
                content: '/';
                color: #2bb673;
                font-size: 25px;
                top: auto;
                position: relative;
                margin-right: 10px;
            }

            .activity-item .content .rounded {
                margin-left: 0;
                margin-top: 10px;
                margin-bottom: 10px;
            }

            .activity-item .item-arrow {
                height: 20px;
                width: 15%;
                position: relative;
                text-align: center;
                font-size: 35px;
                left: 0;
                -webkit-transition: all .3s ease;
                transition: all .3s ease;
            }

            .activity-item .item-box:hover > .item-arrow {
                color: #25aae1;
                left: 30px;
                -webkit-transition: all .3s ease;
                transition: all .3s ease;
            }

            .rounded {
                width: 70px;
                height: 5px;
                border-radius: 6px;
                background-image: linear-gradient(to right, #25aae1, #40e495);
                margin-left: 0;
                margin-top: 10px;
                margin-bottom: 10px;
            }

            @media screen and (max-width: 768px){

                .activity-item .content {
                    width: 100%;
                    margin-top: 35px;
                }

                .activity-item .content .title {
                    font-size: 18px;
                }

                .activity-item .item-arrow {
                    margin: auto;
                }

                .activity-item .icon {
                    width: 100%;
                }

                .activity-item .icon img {
                    width: 100%;
                    height: 150px;
                    object-fit: cover;
                }

                .activity-item {
                    width: 92%;
                    margin: auto;
                }

                .activity-item .item-box {
                    display: block;
                    padding: 30px;
                }
            }
        </style>
    </head>
    <body>
        <nav class="navbar-expand-sm mx-auto">
