                    <li><a href="fior_di_levante_day_planner">Day Planner</a></li>
                    <% if (locals.user_email == undefined){ %> 
                    <li><a href="fior_di_levante_sign">Sign Up/Sign In</a></li>
                    <% }else{ %> 
                    <li class="dropdown"><a class="dropdown-toggle" data-toggle="dropdown">Account <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="fior_di_levante_profile">Profile</a></li>
                            <li><a href="/logout">Logout</a></li>
                        </ul>
                    </li>
                    <% } %> 
                </ul>
            </div>
        </nav>
        <div class="container">
            <section id="search">
                <form action="/search" method="POST">
                    <input type="text" placeholder="Search..." name="search_input" class="input-field" id="js-voice-output">
                    <button type="button" class="input-field__microphone"><i class="fa fa-microphone"></i></button>
                    <button type="submit" class="input-field__button form-button"><i class="fa fa-search"></i></button>
                </form>
            </section>
            <section id="filters" class="d-flex justify-content-center">
                <button class="btn btn-info" id="all">Show all</button>
                <button class="btn btn-info" id="excursion">Excursion</button>
                <button class="btn btn-info" id="food">Food</button>
                <button class="btn btn-info" id="entertainment">Entertainment</button>
            </section>
            <% if (data.length != 0){
                data.forEach(function(document){%>
                <div class="activity-item <%= document.category %>">
                    <div class="item-box">
                        <div class="icon">
                            <img src="<%= document.image %>" alt="<%= document.name %>">
                        </div>
                        <div class="content">
                            <div class="title"><%= document.name %></div>
                            <div class="rounded"></div>
                            <span class="activity-category"><%= document.category %></span>
                        </div>
                    </div>
                </div>
                <% }) %>
            <% }else{ %>
                <div>
                    <h1>There are no activities found!</h1>    
                </div>
            <% } %>
        </div>
        <footer>
            <div class="row">
                <div class="col-lg-4">
                    <h6><b><u>About</b></u></h6>
                    <p>
                        Fior di Levante is a travel guide for the island of Zakynthos. We offer you suggestions for activities, local events, places to stay, to have fun, restaurants to eat  and more. We hope you enjoy your time exploring Zakynthos.
