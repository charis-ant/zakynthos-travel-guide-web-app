                <ul class="nav navbar-nav">
                    <li><a href="fior_di_levante_home">Home</a></li>
                    <li><a href="fior_di_levante_zakynthos">About Zakynthos</a></li>
                    <li><a href="fior_di_levante_accommodation">Accommodation</a></li>
                    <li class="dropdown"><a class="active dropdown-toggle" data-toggle="dropdown">Things to do <span class="caret"></span></a>
                    <ul class="dropdown-menu">
                        <li><a href="fior_di_levante_events">Events</a></li>
                        <li><a class=active href="fior_di_levante_activities">Activities</a></li>
                    </ul>
