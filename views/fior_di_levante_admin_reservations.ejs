<!DOCTYPE html>
<html>
    <head>
        <title>Fior di Levante | Admin Reservations</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css">
        <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>
        
        <script src="https://kit.fontawesome.com/38fe6d47dd.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="http://fonts.cdnfonts.com/css/brightwall" rel="stylesheet">
                
        <link rel="stylesheet" href="../fior_di_levante.css">

        <script src="../fior_di_levante.js"></script>

        <style>
            header {
                text-align: center;
                background-color: #104a6c;
                font-size: 40px;
            }

            .navigation a{
                display: block;
                height: 60px;
                line-height: 60px;
                padding: 0 10px;
                font-size: 20px;
                overflow-x: hidden;
            }

            #table{
                overflow: auto;
            }

            table{
                margin-top: 20px;
            }

            td{
                text-align: center;
            }

            footer{
                margin-top: 191px;
            }
        </style>
    </head>
    <body>
        <header>
            Fior di Levante Admin Zakynthos - Reservations Page
        </header>
        <div class="navbar-expand-lg mx-auto navigation">
            <ul class="nav justify-content-center">
                <li class="nav-item"><a href="fior_di_levante_admin_home" target="_self">Home</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_users" target="_self">Users</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_zakynthos" target="_self">Zakynthos</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_reservations" target="_self">Reservations</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_events" target="_self">Events</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_activities" target="_self">Activities</a></li>
                <li class="nav-item"><a href="/logout">Logout</a></li>
            </ul>
        </div>
        <div class="container">
            <div class="row">
                <section id="numbers" class="mx-auto">
                    <p style="font-size: 20px;"  >Total Number of Reservations:
                        <%  var counter = 0;
                            if (data.length != 0){
                                data.forEach(function(document){
                                    if (document.status != "cancelled"){
                                        counter++;
                                    }
                                }) %>
                                <%= counter%>
                        <% }else{ %>
                            <span>There haven't been any reservations</span>
                        <% } %>
                    </p>
                </section>
            </div>
            <div class="row">
                <section id="table" class="mx-auto">
                    <% if (data.length != 0){ 
                        var index = 0;
                        %>
                        <table class="table table-responsive">
                            <tr>
                                <th>#</th>
                                <th>Accommodation Name</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Status</th>
                                <th>View Information</th>
                                <th>Cancel Reservation</th>
                            </tr>
                            <% data.forEach(function(document){ %>
                                <tr>
                                    <td><%= document._id %></td>
                                    <td><%= document.accommodation %></td>
                                    <td><%= document.checkIn %></td>
                                    <td><%= document.checkOut %></td>
                                    <td style="text-transform: uppercase;"><%= document.status %></td>
                                    <td><button type="button" class="btn btn-primary" data-toggle="modal" data-target="#myModal<%= index %>">VIEW</button></td>
                                    <td><a class="btn btn-danger" href="cancel_reservation?cancel_id=<%= document._id %>" role="button">CANCEL</a></td>   
                                </tr>
                                <div class="modal fade" id="myModal<%= index %>" role="dialog">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Reservation ID: <%= document._id %></h5>
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                <spa><h4>Number of Guests: <%= document.people %></h4></spa>
                                                <hr>
                                                <% for (var i = 1; i<document.name.length; i++) { %>
                                                    <h5>Name: <%= document.name[i] %></h5>
                                                    <h5>Surname: <%= document.surname[i] %></h5>
                                                    <h5>Date Of Birth: <%= document.dob[i] %></h5>
                                                    <h5>ID Number: <%= document.id[i] %></h5>
                                                    <hr>
                                                <% } %>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% index++; }) %>
                        </table>
                    <% }else{ %>
                        <div>
                            <h1>There have been no reservations!</h1>    
                        </div>
                    <% } %>
                </section>
            </div>
        </div>
        <footer>
            <div class="row">
                <div class="justify-content-center">
                    <h6><b><u>About</b></u></h6>
                    <p>
                        Fior di Levante is a travel guide for the island of Zakynthos. We offer you suggestions for activities, local events, places to stay, to have fun, restaurants to eat  and more. We hope you enjoy your time exploring Zakynthos.
                    </p>
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-lg-6"><p class="copyright-text" style="line-height: 90px; text-align: center;">&copy; Fior di Levante 2022. All rights reserved.</p></div>
                <div class="col-lg-6">
                    <ul class="social-icons">
                        <li><a class="facebook" href="https://www.facebook.com/ds.unipi.gr" target="_blank"><i class="fab fa-facebook-f"></i></a></li>
                        <li><a class="instagram" href="https://www.instagram.com/haarrisa/" target="_blank"><i class="fab fa-instagram"></i></a></li>
                        <li><a class="email" href="mailto:harisantoniadi@gmail.com"><i class="fa-solid fa-envelope"></i></a></li>
                        <li><a class="telephone" href="tel:+30210 4142000"><i class="fas fa-phone"></i></a></li>
                    </ul>
                </div>
            </div>
        </footer>         
    </body>
</html>