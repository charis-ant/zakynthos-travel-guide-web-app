<!DOCTYPE html>
<html>
    <head>
        <title>Fior di Levante | Rate Zakynthos</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css">
        <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>

        <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
        
        <script src="https://kit.fontawesome.com/38fe6d47dd.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="http://fonts.cdnfonts.com/css/brightwall" rel="stylesheet">
                
        <link rel="stylesheet" href="../fior_di_levante.css">

        <script src="../fior_di_levante.js"></script>

        <style>
            form{
                width: 50%;
            }

            form .text-data .img-data{
                font-size: 18px;
                margin-left: 15px;
                margin-right: 15px;
                margin-top: 20px;
                width: 50%;
            }

            .text-data label::before, .img-data label::before{
                margin: 28px 0 0;
                font-size: 14px;
                color: #5a5a5a;
            }

            .text-data input, .img-data input{
                margin-bottom: 15px;
                width: 100%;
                padding: 10px;
                background: none;
                outline: none;
                border: 0;
                border-bottom: 2px solid #949290;
            }

            .required{
                color: red;
            }

            .text-data input:focus, .img-data input:focus{
                outline: none;
                border: 0;
                transition: all 0.3s;
                border-bottom: 2px solid #104a6c;
            }

            .form-button{
                float: right;
                padding: 8px 12px;
                margin-top: 20px;
                margin-right: 20px;
                border: 2px solid #949290;
                background: 0;
                color: #949290;
                cursor: pointer;
                clear: both;
            }

            .form-button:hover{
                transition: all 0.3s;
                background: #104a6c;
                border: 2px solid #104a6c;
                color: rgb(235,235,235);
            }

            .rate {
                height: 46px;
                padding: 0 10px;
            }

            .rate:not(:checked) > input {
                position:absolute;
                top:-9999px;
            }
            
            .rate:not(:checked) > label {
                float:right;
                width:1em;
                overflow:hidden;
                white-space:nowrap;
                cursor:pointer;
                font-size:30px;
                color:#ccc;
            }
            
            .rate:not(:checked) > label:before {
                content: '★ ';
            }
            
            .rate > input:checked ~ label {
                color: #ffc700;    
            }
            
            .rate:not(:checked) > label:hover,
            
            .rate:not(:checked) > label:hover ~ label {
                color: #deb217;  
            }
            
            .rate > input:checked + label:hover,
            .rate > input:checked + label:hover ~ label,
            .rate > input:checked ~ label:hover,
            .rate > input:checked ~ label:hover ~ label,
            
            .rate > label:hover ~ input:checked ~ label {
                color: #c59b08;
            }
        </style>
    </head>
    <body>
        <nav class="navbar-expand-sm">
            <div id="logo_img" class="d-flex justify-content-center">
                <a href="fior_di_levante_home"><img src="../images/logo.png" alt="logo" width="300px"></a>
            </div>
            <div class="container-fluid d-flex justify-content-center">
                <ul class="nav navbar-nav">
                    <li><a href="fior_di_levante_home">Home</a></li>
                    <li><a href="fior_di_levante_zakynthos">About Zakynthos</a></li>
                    <li><a href="fior_di_levante_accommodation">Accommodation</a></li>
                    <li class="dropdown"><a class="dropdown-toggle" data-toggle="dropdown">Things to do <span class="caret"></span></a>
                    <ul class="dropdown-menu">
                        <li><a href="fior_di_levante_events">Events</a></li>
                        <li><a href="fior_di_levante_activities">Activities</a></li>
                    </ul>
                    </li>
                    <li><a href="fior_di_levante_day_planner">Day Planner</a></li>
                     <% if (locals.user_email == undefined){ %> 
                    <li><a href="fior_di_levante_sign">Sign Up/Sign In</a></li>
                    <% }else{ %> 
                    <li class="dropdown"><a class="dropdown-toggle" data-toggle="dropdown">Account <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="fior_di_levante_profile">Profile</a></li>
                            <li><a href="/logout">Logout</a></li>
                        </ul>
                    </li>
                    <% } %> 
                </ul>
            </div>
        </nav>
        <div class="container">
            <form class="rating mx-auto">
                <div class="text-data">
                    <label for="name">Name<span class="required"> *</span></label>
                    <input type="text" id="name" name="name" required placeholder="Enter your full name">
                    <label for="email">Email</label>
                    <input type="text" id="email" name="email" placeholder="Enter your email address">
                    <label for="message">What's on your mind?<span class="required"> *</span></label>
                    <input type="text" name="message" required placeholder="Type your message here"></input>
                </div>
                <div class="img-data">
                    <label for="img">Select image:</label>
                    <input type="file" id="img" name="img" accept="image/*">
                </div>
                <br>
                <h5 align="center" class="justify-content-center">Rate your experience in Zakynthos</h5>
                <section class="d-flex justify-content-center">
                    <div class="rate">
                        <input type="radio" id="star1" name="rate" value="1" />
                        <label for="star1" title="text">1 star</label>
                        <input type="radio" id="star2" name="rate" value="2" />
                        <label for="star2" title="text">2 stars</label>
                        <input type="radio" id="star3" name="rate" value="3" />
                        <label for="star3" title="text">3 stars</label>
                        <input type="radio" id="star4" name="rate" value="4" />
                        <label for="star4" title="text">4 stars</label>
                        <input type="radio" id="star5" name="rate" value="5" hidden/>
                        <label for="star5" title="text">5 stars</label>
                    </div>
                </section>
                <button class="form-button" type="submit">Save Changes</button>
            </form>
        </div>
        <footer>
            <div class="row">
                <div class="col-lg-4">
                    <h6><b><u>About</b></u></h6>
                    <p>
                        Fior di Levante is a travel guide for the island of Zakynthos. We offer you suggestions for activities, local events, places to stay, to have fun, restaurants to eat  and more. We hope you enjoy your time exploring Zakynthos.
                    </p>
                </div>
                <div class="col-lg-4">
                    <h6><b><u>Categories</b></u></h6>
                    <ul class="list-unstyled">
                        <li><a href="fior_di_levante_zakynthos" target="_self">Zakynthos</a></li>
                        <li><a href="fior_di_levante_privacy_policy">Privacy Policy</a></li>
                        <li><a href="fior_di_levante_terms_conditions">Terms & Conditions</a></li>
                        <li><a href="fior_di_levante_rating">Rate Zakynthos</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6><b><u>Payment Methods</b></u></h6>
                    <ul class="list-unstyled">
                        <li>
                            <i style="font-size:30px" class="fa fa-cc-mastercard"></i>
                            <i style="font-size:30px" class="fa fa-cc-visa"></i>
                            <i style="font-size:30px" class="fa fa-cc-amex"></i>
                            <i style="font-size:30px" class="fa fa-cc-diners-club"></i>
