<!DOCTYPE html>
<html>
    <head>
        <title>Fior di Levante | Admin Activities</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css">
        <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>
        
        <script src="https://kit.fontawesome.com/38fe6d47dd.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="http://fonts.cdnfonts.com/css/brightwall" rel="stylesheet">
                
        <link rel="stylesheet" href="../fior_di_levante.css">

        <script src="../fior_di_levante.js"></script>

        <script>
            /*ACTIVITIES FILTER*/
            $(document).ready(function(){
                var $activities = $(".activity-item");
                $("#filters > button").click(function(e){
                    e.preventDefault();
                    console.log("what is this: " + this.id);
                    var filter = this.id;
                    if (filter == "all"){
                        $activities.show();
                    }else {
                        $activities.hide().filter('.'+filter).show();
                    }
                });
            });
        </script>

        <style>
            header {
                text-align: center;
                background-color: #104a6c;
                font-size: 40px;
            }

            .navigation a{
                display: block;
                height: 60px;
                line-height: 60px;
                padding: 0 10px;
                font-size: 20px;
                overflow-x: hidden;
            }

            .activity-category{
                display:inline-block;
            }

            .activity-category::first-letter {
                text-transform: uppercase;
            }

            .activity-item img {
                width: 100%;
                display: block;
            }

            .activity-item .item-box {
                display: flex;
                padding: 50px;
                overflow: hidden;
                align-items: center;
                max-width: 1000px;
                margin: auto;
                color: #333;
                border: 1px solid;
                font-size: 16px;
                border-radius: 6px;
                margin-bottom: 50px;
                text-decoration: none;
            }

            .activity-item .icon {
                width: 35%;
                object-fit: cover;
                margin-right: 50px;
                border-radius: 6px;
                overflow: hidden;
                box-shadow: 0 15px 26px rgba(0, 0, 0, 0.4);
            }

            .activity-item .content {
                width: 65%;
            }

            .activity-item .content .title{
                font-size: 21px;
                text-transform: capitalize;
                color: #25aae1;
                font-weight: 600;
            }



            .activity-item .content .title :before{
                font-size: 12px;
                margin-left: 20px;
                color: #333;
            }

            .activity-item .content .title {
                content: '/';
                color: #2bb673;
                font-size: 25px;
                top: auto;
                position: relative;
                margin-right: 10px;
            }

            .activity-item .content .rounded {
                margin-left: 0;
                margin-top: 10px;
                margin-bottom: 10px;
            }

            .rounded {
                width: 70px;
                height: 5px;
                border-radius: 6px;
                background-image: linear-gradient(to right, #25aae1, #40e495);
                margin-left: 0;
                margin-top: 10px;
                margin-bottom: 10px;
            }

            @media screen and (max-width: 768px){

                .activity-item .content {
                    width: 100%;
                    margin-top: 35px;
                }

                .activity-item .content .title {
                    font-size: 18px;
                }

                .activity-item .icon {
                    width: 100%;
                }

                .activity-item .icon img {
                    width: 100%;
                    height: 150px;
                    object-fit: cover;
                }

                .activity-item {
                    width: 92%;
                    margin: auto;
                }

                .activity-item .item-box {
                    display: block;
                    padding: 30px;
                }
            }
        </style>
    </head>
    <body>
        <header>
            Fior di Levante Admin Activities Page
        </header>
        <div class="container">
            <div class="navbar-expand-lg mx-auto navigation">
                <ul class="nav justify-content-center">
                    <li class="nav-item"><a href="fior_di_levante_admin_home" target="_self">Home</a></li>
                    <li class="nav-item"><a href="fior_di_levante_admin_users" target="_self">Users</a></li>
                    <li class="nav-item"><a href="fior_di_levante_admin_zakynthos" target="_self">Zakynthos</a></li>
                    <li class="nav-item"><a href="fior_di_levante_admin_reservations" target="_self">Reservations</a></li>
                    <li class="nav-item"><a href="fior_di_levante_admin_events" target="_self">Events</a></li>
                    <li class="nav-item"><a href="fior_di_levante_admin_activities" target="_self">Activities</a></li>
                    <li class="nav-item"><a href="/logout">Logout</a></li>
                </ul>
            </div>
            <div class="row">
                <section id="activities" class="mx-auto">
                    <% if (data.length != 0){
                        data.forEach(function(document){%>
                        <div class="activity-item <%= document.category %>">
                            <div class="item-box">
                                <div class="icon">
                                    <img src="<%= document.image %>" alt="<%= document.name %>">
                                </div>
                                <div class="content">
                                    <div class="title"><%= document.name %></div>
                                    <div class="rounded"></div>
                                    <span class="activity-category"><%= document.category %></span>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    <% }else{ %>
                        <div>
                            <h1>There are no activities found!</h1>    
                        </div>
                    <% } %>
                </section>
            </div>
            <hr>
            <div class="row">
                <section id="add-activity" class="admin-forms col-lg-4 col-md-6">
                    <h3>Add a new activity</h3>
                    <form method="POST" action="/add_activity" class="general-form">
                        <label for="name">Activity Name<span class="required"> *</span></label><br>
                        <input type="text" id="name" name="name" required placeholder="Enter activity name"><br>
                        
                        <label for="category">Category<span class="required"> *</span></label><br>
                        <input type="text" id="category" name="category" required placeholder="Enter activity category"><br>
                        
                        <label for="url">Image Location<span class="required"> *</span></label><br>
                        <input type="text" id="url" name="url" required placeholder="Enter image's url"><br>
                        
                        <button class="btn btn-info" type="submit">Submit</button>
                        <p><span class="required">*</span>Required field</p>
                    </form>
                </section>
                <section id="update-activity" class="admin-forms middle col-lg-4 col-md-6">
                    <h3>Update an activity</h3>
                    <form method="POST" action="/update_activity" class="general-form"> 
                        <label for="name">Activity Name<span class="required"> *</span></label><br>
                        <input type="text" id="name" name="name" required placeholder="Enter activity name"><br>

                        <label for="updated_name">New activity name<span class="required"> *</span></label><br>
                        <input type="text" id="updated_name" name="updated_name" required placeholder="Enter new activity name"><br>
                        
                        <label for="category">New activity category<span class="required"> *</span></label><br>
                        <input type="text" id="category" name="category" required placeholder="Enter new activity category"><br>

                        <label for="url">New activity image location<span class="required"> *</span></label><br>
                        <input type="text" id="url" name="url" required placeholder="Enter new image url"><br>
                        
                        <button class="btn btn-info" type="submit">Submit</button>
                        <p><span class="required">*</span>Required field</p>
                    </form>
                </section>
                <section id="remove-activity" class="admin-forms col-lg-4 col-md-6">
                    <h3>Delete an activity</h3>
                    <form method="POST" action="/remove_activity" class="general-form"> 
                        <label for="name">Activity Name<span class="required"> *</span></label><br>
                        <input type="text" id="name" name="name" required placeholder="Enter activity name"> <br>
                        <button class="btn btn-info" type="submit">Submit</button>
                        <p><span class="required">*</span>Required field</p>
                    </form>
                </section>
            </div>
        </div>
        <footer>
            <div class="row">
                <div class="justify-content-center">
                    <h6><b><u>About</b></u></h6>
                    <p>
                        Fior di Levante is a travel guide for the island of Zakynthos. We offer you suggestions for activities, local events, places to stay, to have fun, restaurants to eat  and more. We hope you enjoy your time exploring Zakynthos.
                    </p>
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-lg-6"><p class="copyright-text" style="line-height: 90px; text-align: center;">&copy; Fior di Levante 2022. All rights reserved.</p></div>
                <div class="col-lg-6">
                    <ul class="social-icons">
                        <li><a class="facebook" href="https://www.facebook.com/ds.unipi.gr" target="_blank"><i class="fab fa-facebook-f"></i></a></li>
                        <li><a class="instagram" href="https://www.instagram.com/haarrisa/" target="_blank"><i class="fab fa-instagram"></i></a></li>
                        <li><a class="email" href="mailto:harisantoniadi@gmail.com"><i class="fa-solid fa-envelope"></i></a></li>
                        <li><a class="telephone" href="tel:+30210 4142000"><i class="fas fa-phone"></i></a></li>
                    </ul>
                </div>
            </div>
        </footer>         
    </body>
</html>