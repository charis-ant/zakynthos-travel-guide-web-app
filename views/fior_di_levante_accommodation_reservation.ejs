<!DOCTYPE html>
<html>
    <head>
        <title>Fior di Levante | Accommodation Reservation</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css">
        <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>

        <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
        
        <script src="https://kit.fontawesome.com/38fe6d47dd.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="http://fonts.cdnfonts.com/css/brightwall" rel="stylesheet">
                
        <link rel="stylesheet" href="../fior_di_levante.css">

        <script src="../fior_di_levante.js" defer></script>

        <style>
            #forms-1-2 form, #form-3{
                font-size: 18px;
                margin-left: 15px;
                margin-right: 15px;
                margin-top: 20px;
                width: 50%;
                margin-left: auto;
                margin-right: auto;
            }

            #forms-1-2 label::before, #form-3 label::before{
                margin: 28px 0 0;
                font-size: 14px;
                color: #5a5a5a;
            }

            #forms-1-2 input, #form-3 input{
                margin-bottom: 15px;
                width: 100%;
                padding: 10px;
                background: none;
                outline: none;
                border: 0;
                border-bottom: 2px solid #949290;
            }

            #forms-1-2 input:focus, #form-3 input:focus{
                transition: all 0.3s;
                border-bottom: 2px solid #104a6c;
            }

            #forms-1-2 .form-button, #form-3 .form-button{
                float: right;
                padding: 8px 12px;
                margin-top: 20px;
                margin-right: 20px;
                border: 2px solid #949290;
                background: 0;
                color: #949290;
                cursor: pointer;
                clear: both;
            }

            #forms-1-2 .form-button:hover, #form-3 .form-button:hover{
                transition: all 0.3s;
                background: #104a6c;
                border: 2px solid #104a6c;
                color: rgb(235,235,235);
            }

            label.radio {
                cursor: pointer
            }

            label.radio input {
                position: absolute;
                top: 0;
                left: 0;
                visibility: hidden;
                pointer-events: none
            }

            label.radio span {
                padding: 1px 12px;
                border: 2px solid #413832;
                display: inline-block;
                border-radius: 3px;
                text-transform: uppercase;
                font-size: 11px;
                font-weight: 300
            }

            label.radio input:checked+span {
                border-color: #fff;
                background-color: #104a6c;
                border-radius: 3px;
                color: #fff
            }

            .hidden-1{
                display: none;
            }

            .hidden-2{
                display: none;
            }
        </style>
    </head>
    <body>
        <nav class="navbar-expand-sm mx-auto">
            <div id="logo_img" class="d-flex justify-content-center">
                <a href="fior_di_levante_home"><img src="../images/logo.png" alt="logo" width="300px"></a>
            </div>
            <div class="container-fluid d-flex justify-content-center">
                <ul class="nav navbar-nav">
                    <li><a href="fior_di_levante_home">Home</a></li>
                    <li><a href="fior_di_levante_zakynthos">About Zakynthos</a></li>
                    <li><a class=active href="fior_di_levante_accommodation">Accommodation</a></li>
                    <li class="dropdown"><a class="dropdown-toggle" data-toggle="dropdown">Things to do <span class="caret"></span></a>
                    <ul class="dropdown-menu">
                        <li><a href="fior_di_levante_events">Events</a></li>
                        <li><a href="fior_di_levante_activities">Activities</a></li>
                    </ul>
                    </li>
                    <li><a href="fior_di_levante_day_planner">Day Planner</a></li>
                    <% if (locals.user_email == undefined){ %> 
                    <li><a href="fior_di_levante_sign">Sign Up/Sign In</a></li>
                    <% }else{ %> 
                    <li class="dropdown"><a class="dropdown-toggle" data-toggle="dropdown">Account <span class="caret"></span></a>
                        <ul class="dropdown-menu">
                            <li><a href="fior_di_levante_profile">Profile</a></li>
                            <li><a href="/logout">Logout</a></li>
                        </ul>
                    </li>
                    <% } %> 
                </ul>
            </div>
        </nav>
        <div class="container">
            <h2 align="center"><%= data.name %></h2>
            <div class="d-flex justify-content-center">
                <img src="<%= data.image %>" alt="<%= data.name %>">
            </div>
            <br><br>
            <div id="forms-1-2">
                <form id="form-1" method="POST">
                    <div id="form-1-div">
                        <h3 align="center">Reservation details</h3>
                        <div class="check-in">
                            <label for="checkInDay">Check-in:<span class="required"> *</span></label>
                            <input type="date" id="checkInDay" name="checkInDay" max="2022-12-31" onchange="check_out_function()" required>
                            <script>
                                var next_day = new Date();
                                next_day.setDate(next_day.getDate() + 1);
                                next_day.toJSON().slice(0,10);
                                document.getElementById("checkInDay").min = next_day.toJSON().slice(0,10);
                            </script>
                        </div>
                        <div class="checkOutDay">
                            <label for="checkOutDay">Check-out:<span class="required"> *</span></label>
                            <input type="date" id="checkOutDay" name="checkOutDay" max="2022-12-31" required>
                            <script>
                                function check_out_function(){
                                    document.getElementById("checkOutDay").min = document.getElementById("checkInDay").value;
                                }
                            </script>
                        </div>
                        <label for="persons">Choose number of people:<span class="required"> *</span></label>
                        <select name="persons" id="persons" class="selection" required>
                            <option disabled selected value> -- select an option -- </option>
                            <option value="1">1 person</option>
                            <option value="2">2 persons</option>
                            <option value="3">3 persons</option>
                            <option value="4">4 persons</option>
                            <option value="5">5 persons</option>
                        </select><br><br>
                        <button class="form-button" id="button-form-1" type="button" onclick="calculate()">Next Step</button>
                    </div>
                </form>
                <hr class="hidden-1">
                <br>
                <form id="form-2" method="POST" class="hidden-1">
                    <div id="form-2-div">
                        <h3 align="center">Reservation details - Personal Information</h3>
                        <div id="clones">
                            <label for="name">Name<span class="required"> *</span></label><br>
                            <input type="text" id="name" name="name[]" required placeholder="Enter your first name"><br>
            
                            <label for="surname">Surname<span class="required"> *</span></label><br>
                            <input type="text" id="surname" name="surname[]" required placeholder="Enter your last name"><br>
                            
                            <label for="dob">Date of Birth<span class="required"> *</span></label><br>
                            <input type="date" id="dob" name="dob[]" required><br>
                            <script>
                                var today = new Date();
                                today.setDate(today.getDate());
                                today.toJSON().slice(0,10);
                                document.getElementById("dob").max = today.toJSON().slice(0,10);
                            </script>
        
                            <label for="id_number">ID Number<span class="required"> *</span></label><br>
                            <input type="text" id="id_number" name="id_number[]" required placeholder="Enter your ID number"><br><br>
                            <hr><br>
                        </div>
                        <div id="new-inputs"></div><br>
                        <span><b>Price <span id="price"><%=data.price %></span>&euro; /per person per night</b></span><br>
                        <label for="total">Total</label>
                        <input type="text" id="total" name="total" readonly><br><br>
                        <script>
                            function calculate(){
                                var price_text = document.getElementById("price").innerText;
                                var price = parseInt(price_text);
        
                                var selected_value_text = document.getElementById("persons").value;
                                var selected_value = parseInt(selected_value_text);
        
                                var check_in_date = document.getElementById("checkInDay").value;
                                var check_out_date = document.getElementById("checkOutDay").value;
                                var parsed_check_in = Date.parse(check_in_date);
                                var parsed_check_out = Date.parse(check_out_date);
        
                                var number_of_days_date =  Math.ceil((Math.abs(parsed_check_out - parsed_check_in))/ (1000*60*60*24));
                                var number_of_days = parseInt(number_of_days_date);
        
                                var total = price * selected_value * number_of_days;
                                document.getElementById("total").value = total;
                            }
                        </script>
                        <button class="form-button" id="button-form-2" type="button">Next Step</button>
                        <p><span class="required">*</span>Required field</p>
                    </div>
                </form>
            </div>
            <hr class="hidden-2">
            <form id="form-3" class="hidden-2" method="POST" action="/add_accommodation_reservation">
                <input name="accommodation_name" value="<%= data.name %>" readonly style="display: none;"></input>
                <div id="final-form"></div>
                <h3 align="center">Reservation details - Payment Information</h3>
                <br>
                <div>
                    <h4>Card details</h4>
                    <span>Card type<span class="required"> *</span></span>
                    <label class="radio"> 
                        <input type="radio" name="cardType" value="msc" checked> 
                        <span><i style="font-size:30px" class="fa fa-cc-mastercard"></i></span> 
                    </label>
                    <label class="radio"> 
                        <input type="radio" name="cardType" value="visa"> 
                        <span><i style="font-size:30px" class="fa fa-cc-visa"></i></span> 
                    </label>
                    <label class="radio"> 
                        <input type="radio" name="cardType" value="amex"> 
                        <span><i style="font-size:30px" class="fa fa-cc-amex"></i></span> 
                    </label>
                    <label class="radio"> 
                        <input type="radio" name="cardType" value="diners"> 
                        <span><i style="font-size:30px" class="fa fa-cc-diners-club"></i></span> 
                    </label>
                    <label class="radio"> 
                        <input type="radio" name="cardType" value="paypal"> 
                        <span><i style="font-size:30px" class="fa fa-paypal"></i></span> 
                    </label><br>
                    <div>
                        <label>Name on card<span class="required"> *</span></label><br>
                        <input type="text" name="cardName" placeholder="Name" required><br><br>
                    </div>
                    <div>
                        <label>Card number<span class="required"> *</span></label>
                        <input type="text" name="digits1" pattern="[0-9]*" maxlength="4" inputmode="numeric" placeholder="eg. 0000" required>
                        <input type="text" name="digits2" pattern="[0-9]*" maxlength="4" inputmode="numeric" placeholder="eg. 0000" required>
                        <input type="text" name="digits3" pattern="[0-9]*" maxlength="4" inputmode="numeric" placeholder="eg. 0000" required>
                        <input type="text" name="digits4" pattern="[0-9]*" maxlength="4" inputmode="numeric" placeholder="eg. 0000" required>
                    </div>
                    <div>
                        <span>Captcha: <span class="required"> *</span></span>
                        <input id="captcha-input" type="number" placeholder="Insert five digit code" required>
                        <label id="captcha-label"></label><br><br>
                    </div>
                </div>
                <button class="form-button" type="submit" id="last-btn" onclick="check()">Submit</button>
                <p><span class="required">*</span>Required field</p>
            </form>
            <script>
                var random_num = Math.floor(Math.random() * (99999 - 10000)) + 10000;
                document.getElementById("captcha-label").innerHTML = random_num;

                function check() {
                    var captcha = document.getElementById("captcha-input").value;
                    if (captcha != random_num) {
                        return alert("Codes must match. Please try again");
                    } else {
                        return alert("Thank You! Redirecting to home page...");
                    }
                }
            </script>
        </div>
