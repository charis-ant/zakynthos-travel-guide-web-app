<!DOCTYPE html>
<html>
    <head>
        <title>Fior di Levante | Admin Users</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css">
        <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.slim.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>
        
        <script src="https://kit.fontawesome.com/38fe6d47dd.js" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="http://fonts.cdnfonts.com/css/brightwall" rel="stylesheet">
                
        <link rel="stylesheet" href="../fior_di_levante.css">

        <script src="../fior_di_levante.js"></script>

        <style>
            header {
                text-align: center;
                background-color: #104a6c;
                font-size: 40px;
            }

            .navigation a{
                display: block;
                height: 60px;
                line-height: 60px;
                padding: 0 10px;
                font-size: 20px;
                overflow-x: hidden;
            }
        </style>
    </head>
    <body>
        <header>
            Fior di Levante Admin Users Page
        </header>
        <div class="navbar-expand-lg mx-auto navigation">
            <ul class="nav justify-content-center">
                <li class="nav-item"><a href="fior_di_levante_admin_home" target="_self">Home</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_users" target="_self">Users</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_zakynthos" target="_self">Zakynthos</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_reservations" target="_self">Reservations</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_events" target="_self">Events</a></li>
                <li class="nav-item"><a href="fior_di_levante_admin_activities" target="_self">Activities</a></li>
                <li class="nav-item"><a href="/logout">Logout</a></li>
            </ul>
        </div>
        <div class="container">
            <p style="font-size: 20px; text-align:center;" >Total Number of Users:
                <%  var counter = 0;
                    if (data.length != 0){
                        data.forEach(function(document){
                            if (document.username != "admin"){
                                counter++;
                            }
                        }) %>
                        <%= counter%>
                <% }else{ %>
                    <span>There are no registered users</span>
                <% } %>
            </p>
            <hr>
            <div class="row">
                <section id="add-user-info" class="admin-forms col-lg-4 col-md-6">
                    <h3>Add user info</h3>
                    <form method="POST" action="/add_user_info" class="general-form"> 
                        <label for="email">User's Email<span class="required"> *</span></label><br>
                        <input type="text" id="email" name="email" required placeholder="Enter user's email address"><br>
                        
                        <label for="field_name">Field Name<span class="required"> *</span></label><br>
                        <input type="text" id="field_name" name="field_name" required placeholder="Enter new field's name"><br>
    
                        <label for="field_value">Field Value<span class="required"> *</span></label><br>
                        <input type="text" id="field_value" name="field_value" required placeholder="Enter new field's value"><br>
    
                        <button class="btn btn-info" type="submit">Submit</button>
                        <p><span class="required">*</span>Required field</p>
                    </form>
                </section>
                <section id="update-user" class="admin-forms middle col-lg-4 col-md-6">
                    <h3>Update user's info</h3>
                    <form method="POST" action="/update_user" class="general-form"> 
                        <label for="email">User's email<span class="required"> *</span></label><br>
                        <input type="text" id="email" name="email" required placeholder="Enter user's email address"><br>
    
                        <label for="name">New Name<span class="required"> *</span></label><br>
                        <input type="text" id="name" name="name" required placeholder="Enter new name"><br>

                        <label for="surname">New surname<span class="required"> *</span></label><br>
                        <input type="text" id="surname" name="surname" required placeholder="Enter new surname"><br>

                        <label for="username">New username<span class="required"> *</span></label><br>
                        <input type="text" id="username" name="username" required placeholder="Enter new username"><br>
                            
                        <button class="btn btn-info" type="submit">Submit</button>
                        <p><span class="required">*</span>Required field</p>
                    </form>
                </section>
                <section id="remove-user" class="admin-forms col-lg-4 col-md-6">
                    <h3>Delete user</h3>
                    <form method="POST" action="/delete_user" class="general-form"> 
                        <label for="email">User's email<span class="required"> *</span></label><br>
                        <input type="text" id="email" name="email" required placeholder="Enter user's email address"><br>
                        
                        <button class="btn btn-info" type="submit">Submit</button>
                        <p><span class="required">*</span>Required field</p>
                    </form>
                </section>
            </div>
        </div>
        <footer>
            <div class="row">
                <div class="justify-content-center">
                    <h6><b><u>About</b></u></h6>
                    <p>
                        Fior di Levante is a travel guide for the island of Zakynthos. We offer you suggestions for activities, local events, places to stay, to have fun, restaurants to eat  and more. We hope you enjoy your time exploring Zakynthos.
                    </p>
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-lg-6"><p class="copyright-text" style="line-height: 90px; text-align: center;">&copy; Fior di Levante 2022. All rights reserved.</p></div>
                <div class="col-lg-6">
                    <ul class="social-icons">
                        <li><a class="facebook" href="https://www.facebook.com/ds.unipi.gr" target="_blank"><i class="fab fa-facebook-f"></i></a></li>
                        <li><a class="instagram" href="https://www.instagram.com/haarrisa/" target="_blank"><i class="fab fa-instagram"></i></a></li>
                        <li><a class="email" href="mailto:harisantoniadi@gmail.com"><i class="fa-solid fa-envelope"></i></a></li>
                        <li><a class="telephone" href="tel:+30210 4142000"><i class="fas fa-phone"></i></a></li>
                    </ul>
                </div>
            </div>
        </footer>         
    </body>
</html>